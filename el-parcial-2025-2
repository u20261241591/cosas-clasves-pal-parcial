package repasoparaparcial;

import java.util.Arrays;
import java.util.Scanner;

/**
 *
 * @author Danny Nicolás Gutiérrez Mejía
 */
public class RepasoParaParcial {

    // ERROR 1: faltaba declarar el Scanner.
    // El método procesarTemperaturas usaba "sc.nextDouble()" pero "sc" nunca
    // había sido creado en ninguna parte de la clase, por lo que el código
    // no compilaba (error "cannot find symbol"). Se declara aquí como campo
    // estático para que esté disponible en todos los métodos que lo necesiten.
    static Scanner sc = new Scanner(System.in);

    public static void main(String[] args) {
        double[] rivera = new double[12];
        double[] neiva = new double[12];
        double[] campoalegre = new double[12];
        double[] copia = new double[12];

        rivera = procesarTemperaturas(true, 21, 31);
        neiva = procesarTemperaturas(true, 25, 40);
        campoalegre = procesarTemperaturas(true, 24, 38);

        int resComp = compararSubestaciones(rivera, neiva); /*Rivera entra como el competidor 1 y Neiva como el 2
           aqui sabemos con el metodo compararSubestaciones cual es mas caliente
           si gana el 1 (rivera) sería el mas caliente y si gana el 2 (neiva) sería la mas caliente*/
        System.out.println("compararSubestaciones: " + resComp);
        resComp = compararSubestaciones(neiva, rivera);
        System.out.println("compararSubestaciones: " + resComp);
        resComp = compararSubestaciones(neiva, neiva);
        System.out.println("compararSubestaciones: " + resComp);

        // ERROR 2: "copia = rivera;" NO crea una copia del arreglo.
        // En Java los arreglos son objetos, así que esta línea solo hacía que
        // "copia" apuntara al mismo arreglo que "rivera" (misma dirección en
        // memoria). Al modificar copia[1] y copia[10] más abajo, en realidad
        // también se estaban modificando los datos originales de "rivera",
        // lo cual no era la intención (se quería trabajar sobre una copia
        // independiente). Se usa Arrays.copyOf para clonar el contenido.
        copia = Arrays.copyOf(rivera, rivera.length);
        copia[1] = 15;
        copia[10] = 35;

        int[] anomalias = detectarAnomalias(copia);

        // ERROR 3: "if (anomalias[j] != null)" no compilaba.
        // detectarAnomalias devuelve un arreglo de "int" (tipo primitivo), y
        // los primitivos nunca pueden ser null en Java, solo los tipos
        // objeto (como Integer) pueden serlo. Comparar un int contra null
        // produce un error de compilación. Ahora que detectarAnomalias
        // devuelve solo las posiciones realmente encontradas (ver ERROR 4),
        // ya no hace falta esa comparación: simplemente se recorre el
        // arreglo tal cual.
        for (int j = 0; j < anomalias.length; j++) {
            System.out.println(anomalias[j]);
        }

        // ERROR 4 (relacionado con el anterior): reporteMensual estaba
        // llamado DENTRO del for de anomalías, por lo que el reporte
        // completo (los 12 meses, el mes más cálido, el más frío y el
        // promedio) se imprimía una vez por cada anomalía encontrada, en
        // vez de imprimirse una sola vez. Se saca del bucle para que se
        // ejecute solo una vez.
        reporteMensual("rivera", rivera);

        mostrarArreglo(copia);
    }

    public static double[] procesarTemperaturas(boolean tipoGenerador, double tempMin, double tempMax) {
        double[] temperaturas = new double[12];
        if (tipoGenerador == true) {
            //generación automatica
            for (int i = 0; i < temperaturas.length; i++) {
                temperaturas[i] = (Math.random() * (tempMax + 1 - tempMin) + (tempMin));
            }
        } else {
            for (int i = 0; i < temperaturas.length; i++) {
                System.out.println("digite la temperatura numero: " + i);
                temperaturas[i] = sc.nextDouble();
            }
        }
        return temperaturas;
    }

    public static void mostrarArreglo(double[] estacion) {
        for (int i = 0; i < estacion.length; i++) {
            System.out.println(estacion[i]);
        }
    }

    public static int compararSubestaciones(double[] t1, double[] t2) {
        int masAlta;
        double prom1 = promedioArreglos(t1);
        double prom2 = promedioArreglos(t2);
        if (prom1 > prom2) {
            masAlta = 1;
        } else if (prom1 < prom2) {
            masAlta = 2;
        } else {
            masAlta = 0;
        }
        return masAlta;
    }

    public static double promedioArreglos(double[] arreglo) {
        double promedio, suma = 0;
        for (int i = 0; i < arreglo.length; i++) {
            suma = suma + arreglo[i];
        }
        promedio = suma / arreglo.length;
        return promedio;
    }

    public static int[] detectarAnomalias(double[] temperaturas) {
        // ERROR 5: el arreglo de anomalías se creaba con tamaño fijo 12 y
        // solo se llenaban las primeras "indAnomalias" posiciones; el resto
        // quedaban en 0 (valor por defecto de int en Java). El problema es
        // que 0 también es un índice válido (representa "enero"), así que
        // no había forma de distinguir "aquí no hay anomalía" de "la
        // anomalía está en enero". Esto es justo lo que causaba el ERROR 3
        // en el main (se intentaba comparar esos "huecos" con null).
        // La solución es devolver un arreglo del tamaño real de anomalías
        // encontradas, usando Arrays.copyOf al final.
        int[] anomaliasTemp = new int[temperaturas.length];
        int indAnomalias = 0;
        double prom = promedioArreglos(temperaturas);
        for (int i = 0; i < temperaturas.length; i++) {
            if (temperaturas[i] >= (prom * 1.2) || temperaturas[i] <= (prom * 0.8)) {
                anomaliasTemp[indAnomalias] = i;
                indAnomalias++;
            }
        }
        return Arrays.copyOf(anomaliasTemp, indAnomalias);
    }

    public static void reporteMensual(String nombre, double[] temperaturas) {
        String[] meses = {"ENERO", "FEBRERO", "MARZO", "ABRIL", "MAYO", "JUNIO", "JULIO", "AGOSTO", "SEPTIEMBRE", "OCTUBRE", "NOVIEMBRE", "DICIEMBRE"};
        double prom = promedioArreglos(temperaturas);
        System.out.println("informe temperaturas estacion: " + nombre);
        System.out.println("mes     promedio mes");
        for (int k = 0; k < temperaturas.length; k++) {
            System.out.println(meses[k] + "       " + temperaturas[k]);
        }
        System.out.println("mes mas calido: " + meses[mesMayorTemp(temperaturas)]);
        System.out.println("mes menos calido: " + meses[mesMenorTemp(temperaturas)]);
        System.out.println("promedio del año: " + prom);
    }

    public static int mesMayorTemp(double[] estacion) {
        int mesAlto = 0;
        double tempAlta = estacion[0];
        for (int k = 0; k < estacion.length; k++) {
            if (estacion[k] > tempAlta) {
                tempAlta = estacion[k];
                mesAlto = k;
            }
        }
        return mesAlto;
    }

    public static int mesMenorTemp(double[] estacion) {
        int mesBajo = 0;
        double tempBaja = estacion[0];
        for (int k = 0; k < estacion.length; k++) {
            if (estacion[k] < tempBaja) {
                tempBaja = estacion[k];
                mesBajo = k;
            }
        }
        return mesBajo;
    }
}
