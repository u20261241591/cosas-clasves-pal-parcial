package repasoparaparcial;

import java.util.Arrays;
import java.util.Scanner;

/**
 * MonitorClimaticoRegional
 * ------------------------
 * Simula una estación meteorológica central que recibe datos de temperatura
 * mensual (12 meses) desde tres subestaciones: Rivera, Neiva y Campoalegre.
 * Permite generar, comparar, analizar y reportar esos datos.
 *
 * Patrón general usado en este parcial (útil para parciales similares):
 * 1) Método generador de datos (aleatorio o manual)
 * 2) Método auxiliar de promedio (lo usan casi todos los demás)
 * 3) Método comparador entre dos arreglos (basado en el promedio)
 * 4) Método detector de anomalías (umbral relativo al promedio)
 * 5) Método de reporte (usa promedio + mayor + menor)
 *
 * @author Jesús David Tovar Rojas (código base) — con guía paso a paso
 */
public class MonitorClimaticoRegional {

    public static void main(String[] args) {

        // Se generan las temperaturas de las 3 subestaciones de forma
        // automática (true), con rangos de temperatura distintos para cada una.
        double[] rivera = generarTemperaturas(true, 21, 31);
        double[] neiva = generarTemperaturas(true, 25, 40);
        double[] campoalegre = generarTemperaturas(true, 24, 38);

        // Se comparan dos subestaciones según su promedio anual.
        // Resultado: 1 = gana el primer arreglo, 2 = gana el segundo, 0 = empate.
        int resultado = compararSubestaciones(rivera, neiva);
        System.out.println("Resultado comparacion Rivera vs Neiva: " + resultado);

        // Se detectan los meses con anomalías térmicas (±20% del promedio).
        int[] anomaliasRivera = detectarAnomalias(rivera);
        System.out.println("Cantidad de anomalias en Rivera: " + anomaliasRivera.length);
        for (int i = 0; i < anomaliasRivera.length; i++) {
            System.out.println("Mes con anomalia (indice): " + anomaliasRivera[i]);
        }

        // Se imprime el reporte completo de cada subestación:
        // todos los meses, el mes más cálido, el más frío y el promedio.
        reporteMensual("Rivera", rivera);
        reporteMensual("Neiva", neiva);
        reporteMensual("Campoalegre", campoalegre);
    }

    /**
     * Genera (o pide) las 12 temperaturas mensuales de una subestación.
     *
     * @param tipoGeneracion true = genera valores aleatorios entre tempMin y
     *                       tempMax; false = pide cada valor por teclado.
     * @param tempMin        temperatura mínima permitida.
     * @param tempMax        temperatura máxima permitida.
     * @return arreglo de 12 posiciones con las temperaturas del año.
     */
    public static double[] generarTemperaturas(boolean tipoGeneracion, double tempMin, double tempMax) {
        double[] temperaturas = new double[12];

        if (tipoGeneracion == true) {
            // Generación automática: formula general para un aleatorio en
            // un rango [min, max]:  Math.random() * (max - min + 1) + min
            for (int i = 0; i < temperaturas.length; i++) {
                temperaturas[i] = (Math.random() * (tempMax + 1 - tempMin) + (tempMin));
            }
        } else {
            // Generación manual: se declara el Scanner AQUÍ, solo cuando
            // realmente se necesita pedir datos por teclado. Si se necesitara
            // en más de un método, conviene declararlo como campo estático
            // de la clase (arriba del main) para reutilizar el mismo objeto.
            Scanner sc = new Scanner(System.in);
            for (int i = 0; i < temperaturas.length; i++) {
                System.out.println("digite la temperatura");
                temperaturas[i] = sc.nextDouble();
                System.out.println(temperaturas[i]);
            }
        }
        return temperaturas;
    }

    /**
     * Calcula el promedio de un arreglo de temperaturas.
     * Es el método auxiliar base: lo usan compararSubestaciones,
     * detectarAnomalias y reporteMensual.
     *
     * @param arreglo arreglo de temperaturas.
     * @return el promedio (suma de todos los valores / cantidad de valores).
     */
    public static double promedio(double arreglo[]) {
        double suma = 0;
        for (int i = 0; i < arreglo.length; i++) {
            suma = suma + arreglo[i];
        }
        double prom = suma / arreglo.length; // OJO: dividir entre la cantidad
        return prom;                          // real de elementos, no un número fijo.
    }

    /**
     * Compara dos subestaciones según su promedio de temperatura anual.
     *
     * @param num1 temperaturas de la primera subestación.
     * @param num2 temperaturas de la segunda subestación.
     * @return 1 si num1 tiene mayor promedio, 2 si num2 tiene mayor
     *         promedio, 0 si son iguales.
     */
    public static int compararSubestaciones(double[] num1, double[] num2) {
        double prom1 = promedio(num1);
        double prom2 = promedio(num2);
        if (prom1 > prom2) {
            return 1;
        } else if (prom1 < prom2) {
            return 2;
        } else {
            // Se usa "else" simple (no "else if") porque matemáticamente
            // mayor, menor e igual cubren TODOS los casos posibles. Un
            // "else if" adicional deja al compilador sin garantía de que
            // el método siempre retorne un valor (error "missing return").
            return 0;
        }
    }

    /**
     * Detecta los meses con anomalías térmicas: aquellos cuya temperatura
     * está a +/- 20% del promedio anual.
     *
     * @param arreglo temperaturas de una subestación.
     * @return arreglo con los ÍNDICES (no las temperaturas) de los meses
     *         anómalos, recortado al tamaño real encontrado.
     */
    public static int[] detectarAnomalias(double arreglo[]) {
        // Arreglo temporal de tamaño máximo posible (12): no se sabe de
        // antemano cuántas anomalías van a encontrarse.
        int[] anomaliasTemp = new int[12];
        int anomalias = 0; // contador de anomalías encontradas hasta ahora
        double prom = promedio(arreglo);

        for (int i = 0; i < arreglo.length; i++) {
            if (arreglo[i] >= prom * 1.2 || arreglo[i] <= prom * 0.8) {
                anomaliasTemp[anomalias] = i; // se guarda el índice del mes
                anomalias++;                   // se avanza el contador
            }
        }

        // Se recorta el arreglo al tamaño real de anomalías encontradas.
        // Si se devolviera "anomaliasTemp" completo (tamaño 12 fijo), las
        // posiciones sobrantes quedarían en 0 (valor por defecto de int),
        // lo cual se confundiría con "el mes de enero es anomalía".
        return Arrays.copyOf(anomaliasTemp, anomalias);
    }

    /**
     * Busca el índice del mes con la temperatura MÁS ALTA del año.
     *
     * @param temperaturas arreglo de temperaturas de una subestación.
     * @return índice (0 a 11) del mes más cálido.
     */
    public static int mesMayorTemp(double[] temperaturas) {
        int indMayor = 0;                       // se asume que el mayor
        double tempMayor = temperaturas[0];      // está en la posición 0
        for (int i = 0; i < temperaturas.length; i++) {
            if (temperaturas[i] > tempMayor) {
                tempMayor = temperaturas[i]; // se actualiza el valor mayor
                indMayor = i;                // y se guarda su índice
            }
        }
        return indMayor;
    }

    /**
     * Busca el índice del mes con la temperatura MÁS BAJA del año.
     * Misma lógica que mesMayorTemp, pero comparando con "<" en vez de ">".
     *
     * @param temperaturas arreglo de temperaturas de una subestación.
     * @return índice (0 a 11) del mes más frío.
     */
    public static int mesMenorTemp(double[] temperaturas) {
        int indMenor = 0;
        double tempMenor = temperaturas[0];
        for (int i = 0; i < temperaturas.length; i++) {
            if (temperaturas[i] < tempMenor) {
                tempMenor = temperaturas[i];
                indMenor = i;
            }
        }
        return indMenor;
    }

    /**
     * Imprime el resumen estadístico completo de una subestación:
     * todos los meses, el mes más cálido, el más frío y el promedio anual.
     * No devuelve nada (void): solo imprime en consola.
     *
     * @param name         nombre de la subestación (ej. "Rivera").
     * @param temperaturas temperaturas mensuales de esa subestación.
     */
    public static void reporteMensual(String name, double[] temperaturas) {
        // Arreglo de nombres de meses: permite traducir un índice (0-11)
        // devuelto por mesMayorTemp/mesMenorTemp a un nombre legible.
        String[] meses = {"ENERO", "FEBRERO", "MARZO", "ABRIL", "MAYO", "JUNIO",
                           "JULIO", "AGOSTO", "SEPTIEMBRE", "OCTUBRE", "NOVIEMBRE", "DICIEMBRE"};

        System.out.println("Informe temperaturas estacion: " + name);

        for (int i = 0; i < temperaturas.length; i++) {
            System.out.println("Mes " + i + ": " + temperaturas[i]);
        }

        // meses[mesMayorTemp(temperaturas)]: primero se ejecuta el método
        // (devuelve un índice, ej. 3), y luego se usa ese número para
        // acceder a la posición correspondiente del arreglo "meses".
        System.out.println("el mes mas calido es: " + meses[mesMayorTemp(temperaturas)]);
        System.out.println("el mes mas frio es: " + meses[mesMenorTemp(temperaturas)]);
        System.out.println("promedio del año: " + promedio(temperaturas));
    }
}
